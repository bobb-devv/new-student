# Copy this file to .env and replace the password/key placeholders once.
# For example: openssl rand -hex 16 for a dev admin password, and openssl rand -hex 32 for the master key.
SCC_ENV=development
SCC_ADMIN_EMAIL=admin@example.local
SCC_ADMIN_PASSWORD=
SCC_CREDENTIAL_MASTER_KEY=
SCC_IPFS_API_URL=http://127.0.0.1:5001
SCC_IPFS_GATEWAY_URL=http://127.0.0.1:8080
SCC_BASE_URL=http://localhost:4180
SCC_ISSUER_DID_HOST=localhost
SCC_CHAIN_NETWORK="Polygon Amoy"
